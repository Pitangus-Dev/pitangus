# Copy this file to .env and adjust what you need. Everything is optional.
# .env is in .gitignore: never commit it.

# Your host user, so ./data and ./config belong to you:  id -u  /  id -g
PITANGUS_UID=1000
PITANGUS_GID=1000

# Docker socket group. `make` detects it; set it if you start with `docker compose`
# directly on Linux or WSL with native Docker:  stat -Lc %g /var/run/docker.sock
# (don't use 0: that group is always added).
# DOCKER_SOCKET_GID=

# Where it listens on the host. 127.0.0.1 = this machine only (recommended).
PITANGUS_HOST_BIND=127.0.0.1
PITANGUS_HOST_PORT=8766

# URL you open the panel with. If you change the port or the domain, also change
# ALLOWED_ORIGINS. Outside 127.0.0.1/localhost the server requires HTTPS (see README).
PITANGUS_PUBLIC_URL=http://127.0.0.1:8766
PITANGUS_ALLOWED_ORIGINS=http://127.0.0.1:8766,http://localhost:8766

# Language (en or es) for text nobody requests in person: PR comments, notifications,
# Jira issues, scheduled reports and the CLI. The panel follows each person's browser.
PITANGUS_DEFAULT_LOCALE=en

# Master key of the secrets vault (32 bytes in base64): openssl rand -base64 32
# If empty, one is generated in ./config/master.key. Setting it here (or in your secrets
# manager) keeps the key apart from the encrypted vault. If you lose it, you have to enter
# the GitHub App and the Jira token again.
PITANGUS_MASTER_KEY=

# Two-factor authentication: admins (default) · all · none
PITANGUS_REQUIRE_TOTP=admins

# Free NVD API key: the local CVE copy downloads about 8 times faster.
# https://nvd.nist.gov/developers/request-an-api-key
PITANGUS_NVD_API_KEY=

# Allow scanning images from registries on your internal network (private IP). Blocked by default (SSRF).
# PITANGUS_ALLOW_PRIVATE_REGISTRIES=1

# How often, in seconds, pull requests are polled (minimum 60).
PITANGUS_PR_POLL_SECONDS=300

# Only if you really want plain HTTP outside this machine (trusted network).
# PITANGUS_ALLOW_INSECURE_HTTP=1

# —— Server with a domain (docs/deploy-vps.md) ——————————————————————————————
# `make setup DOMAIN=pitangus.example.com [PREBUILT=1]` fills these in. With the domain, Caddy (compose.prod.yaml)
# gets the certificate and redirects HTTP to HTTPS; the API publishes no port of its own and PUBLIC_URL and
# ALLOWED_ORIGINS become https://<domain>.
# PITANGUS_DOMAIN=pitangus.example.com
# The worker runs the engines inside its image, without the Docker socket (compose.no-socket.yaml; SOCKET=1 opts out).
# COMPOSE_FILE=compose.yaml:compose.prod.yaml:compose.no-socket.yaml
# Published images instead of building on the server (PREBUILT=1 adds compose.images.yaml and, without the socket,
# compose.images.no-socket.yaml):
# PITANGUS_IMAGE=ghcr.io/pitangus-dev/pitangus

# Behind your own reverse proxy (Coolify, Dokploy, Traefik, nginx…) and only reachable through it: the proxy
# addresses whose X-Forwarded-For is believed (* = any peer). Sign-in throttling needs the real client address.
# compose.prod.yaml sets it for Caddy.
# PITANGUS_FORWARDED_ALLOW_IPS=

# Prometheus metrics at /api/metrics with `Authorization: Bearer <token>`. Empty = off.
# At least 32 characters: openssl rand -hex 32
PITANGUS_METRICS_TOKEN=

# CI importing other tools' SARIF (POST /api/ci/sarif, `pitangus import-sarif --server`) with
# `Authorization: Bearer <token>`. Empty = off. At least 32 characters: openssl rand -hex 32
PITANGUS_IMPORT_TOKEN=

# Scheduled backups (the `backup` service): add COMPOSE_PROFILES=backup.
# COMPOSE_PROFILES=backup
# PITANGUS_BACKUP_DIR=./backups
# PITANGUS_BACKUP_INTERVAL_HOURS=24
# PITANGUS_BACKUP_KEEP_DAYS=14
# Encrypt every backup (make backup and the service) with age for these public keys (age1… or ssh-ed25519 …,
# comma-separated); the private key stays off this server. Empty = not encrypted, and the master key is left out of
# the backups. The service needs compose.backup-age.yaml in COMPOSE_FILE; make backup, age on the host.
# PITANGUS_BACKUP_AGE_RECIPIENT=

# PostgreSQL password: `make setup` generates it. Leave it empty here.
PITANGUS_DB_PASSWORD=

# —— Other platforms (docs/deploy.md) ———————————————————————————————————————————
# How the worker runs the engines: docker (a container per engine, needs the Docker socket), local (the engines installed
# in the pitangus-worker image, no socket) or auto (Docker if it answers).
# PITANGUS_ENGINE_RUNNER=auto
# leader: a worker runs the periodic tasks on its own clock. external: a scheduler triggers them with
# `pitangus periodic` or GET /api/cron with PITANGUS_CRON_TOKEN (at least 32 characters; Vercel Cron sends CRON_SECRET).
# PITANGUS_PERIODIC=leader
# PITANGUS_CRON_TOKEN=
# Logs: text (default) or json on the process output; PITANGUS_LOG_FILE also keeps a rotated JSON copy (Compose sets it).
# PITANGUS_LOG_FORMAT=text
