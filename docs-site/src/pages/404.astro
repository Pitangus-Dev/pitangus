---
import '@fontsource/ibm-plex-sans/latin-400.css'
import '@fontsource/ibm-plex-sans/latin-600.css'

const home = import.meta.env.BASE_URL
const favicon = `${home}favicon.svg`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <title>Page not found | Pitangus Docs</title>
  </head>
  <body>
    <main>
      <img src={favicon} width="56" height="56" alt="" />
      <p class="meta">404 · Pitangus Docs</p>
      <h1>This page doesn't exist</h1>
      <p>It may have moved when the documentation was reorganized. Search from the home page, or start with the overview.</p>
      <p lang="es">Puede que haya cambiado de lugar al reorganizar la documentación. Busca desde la portada o empieza por la vista general.</p>
      <p class="links">
        <a class="primary" href={home}>Documentation home</a>
        <a href={`${home}es/`} lang="es" hreflang="es">Portada en español</a>
      </p>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
    --bg: #F5F6F7; --surface: #FFFFFF; --line-strong: #80868E; --ink: #16181B; --ink-2: #3D434A; --muted: #5C636B;
    --sulphur: #F2C230; --focus: #16181B;
    font-family: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif;
    background: var(--bg);
    color: var(--ink);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #111315; --surface: #181B1E; --line-strong: #666E76; --ink: #ECEEF0; --ink-2: #C3C8CE; --muted: #9AA1A9;
      --focus: #F2C230;
    }
  }
  body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 1rem; box-sizing: border-box; background: var(--bg); }
  main { width: min(36rem, 100%); }
  img { display: block; margin-bottom: 1.5rem; border-radius: 8px; }
  .meta { margin: 0; color: var(--muted); font-size: 0.875rem; }
  h1 { margin: 0.25rem 0 1rem; font-size: 1.75rem; line-height: 1.25; font-weight: 600; letter-spacing: -0.01em; }
  p { color: var(--ink-2); line-height: 1.6; }
  .links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  a { display: inline-block; border: 1px solid var(--line-strong); border-radius: 6px; padding: 0.5rem 0.875rem; background: var(--surface); color: var(--ink); font-weight: 500; text-decoration: none; }
  a.primary { border-color: var(--sulphur); background: var(--sulphur); color: #16181B; }
  a:hover { text-decoration: underline; }
  :focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
</style>
