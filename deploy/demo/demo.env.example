# Copy to deploy/demo/.env and fill in. Never commit it: it holds the tunnel token.
# The demo's own domain, proxied by Cloudflare (the tunnel's public hostname).
PITANGUS_DEMO_DOMAIN=demo.pitangus.dev
# Zero Trust → Networks → Tunnels → your tunnel → the token in its install command.
CLOUDFLARE_TUNNEL_TOKEN=
# Optional
# PITANGUS_DEFAULT_LOCALE=es
# PITANGUS_DEMO_SUBNET=172.29.80.0/24
# A released image with the public demo mode, instead of building this checkout:
# PITANGUS_DEMO_IMAGE=ghcr.io/pitangus-dev/pitangus:0.16
