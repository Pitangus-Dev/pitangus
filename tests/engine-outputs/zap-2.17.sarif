     "isComprehensive": true,
     "language": "en",
     "minimumRequiredLocalizedDataSemanticVersion": "4.8",
     "name": "CWE",
     "organization": "MITRE",
     "releaseDateUtc": "2022-06-28",
     "shortDescription": {
      "text": "The MITRE Common Weakness Enumeration"
     },
     "taxa": [
      {
       "guid": "b70a7030-c124-3e5f-a628-a76f82820eed",
       "helpUri": "https://cwe.mitre.org/data/definitions/497.html",
       "id": "497"
      },
      {
       "guid": "56c8f6e7-8a2b-3b10-b0db-7fd2adb291eb",
       "helpUri": "https://cwe.mitre.org/data/definitions/525.html",
       "id": "525"
      },
      {
       "guid": "d1f61072-0322-321b-81bf-16250cf04a62",
       "helpUri": "https://cwe.mitre.org/data/definitions/615.html",
       "id": "615"
      },
      {
