            {
              "id": "CWE-639",
              "name": "Broken access control: any user reads other users' profiles (IDOR)",
              "shortDescription": {
                "text": "Broken access control: any user reads other users' profiles (IDOR)"
              },
              "fullDescription": {
                "text": "The profile endpoint returns any user's record for any authenticated session. The request was replayed with Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.c3RyaXgtdGVzdA.sig and the id of another account."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "help": {
                "text": "The profile endpoint returns any user's record for any authenticated session. The request was replayed with Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.c3RyaXgtdGVzdA.sig and the id of another account.\n\nEvery user's email, phone and address can be read by any signed-in user.\n\nCheck that the requested id belongs to the session's user (or that the user is an administrator) before answering.",
                "markdown": "The profile endpoint returns any user's record for any authenticated session. The request was replayed with Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.c3RyaXgtdGVzdA.sig and the id of another account.\n\nEvery user's email, phone and address can be read by any signed-in user.\n\nCheck that the requested id belongs to the session's user (or that the user is an administrator) before answering."
              },
              "properties": {
                "security-severity": "9.1",
                "tags": [
                  "security",
                  "CWE-639",
                  "stride:I",
                  "stride:E"
                ]
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/639.html"
