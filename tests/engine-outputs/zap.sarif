          "rules": [
            {
              "id": "40012",
              "name": "Cross Site Scripting (Reflected)",
              "shortDescription": {"text": "Cross Site Scripting (Reflected)"},
              "fullDescription": {"text": "Cross-site Scripting (XSS) is an attack technique that involves echoing attacker-supplied code into a user's browser instance."},
              "defaultConfiguration": {"level": "error"},
              "helpUri": "https://www.zaproxy.org/docs/alerts/40012/",
              "properties": {
                "references": ["https://owasp.org/www-community/attacks/xss/", "https://cwe.mitre.org/data/definitions/79.html"],
                "solution": {"text": "Phase: Architecture and Design\nUse a vetted library or framework that does not allow this weakness to occur or provides constructs that make this weakness easier to avoid."},
                "confidence": "medium"
              },
              "relationships": [{"kinds": ["superset"], "target": {"guid": "5dd429c8-e5e3-37a8-bf40-f7b2d72a9085", "id": "79", "toolComponent": {"guid": "b000a760-3e52-3565-a35c-f61369da53b7", "name": "CWE"}}}]
            },
            {
              "id": "10038",
              "name": "Content Security Policy (CSP) Header Not Set",
              "shortDescription": {"text": "Content Security Policy (CSP) Header Not Set"},
              "fullDescription": {"text": "Content Security Policy (CSP) is an added layer of security that helps to detect and mitigate certain types of attacks, including Cross Site Scripting (XSS) and data injection attacks."},
              "defaultConfiguration": {"level": "warning"},
              "helpUri": "https://www.zaproxy.org/docs/alerts/10038/",
              "properties": {
                "references": ["https://developer.mozilla.org/en-US/docs/Web/HTTP/CSP"],
                "solution": {"text": "Ensure that your web server, application server, load balancer, etc. is configured to set the Content-Security-Policy header."},
                "confidence": "high"
              },
              "relationships": [{"kinds": ["superset"], "target": {"guid": "0ad96b9a-0d8b-3e23-b0a9-2b4e6e4f8b2c", "id": "693", "toolComponent": {"guid": "b000a760-3e52-3565-a35c-f61369da53b7", "name": "CWE"}}}]
            },
            {
              "id": "10010",
              "name": "Cookie No HttpOnly Flag",
              "shortDescription": {"text": "Cookie No HttpOnly Flag"},
              "fullDescription": {"text": "A cookie has been set without the HttpOnly flag, which means that the cookie can be accessed by JavaScript."},
              "defaultConfiguration": {"level": "note"},
              "helpUri": "https://www.zaproxy.org/docs/alerts/10010/",
              "properties": {
                "references": ["https://owasp.org/www-community/HttpOnly"],
                "solution": {"text": "Ensure that the HttpOnly flag is set for all cookies."},
                "confidence": "medium"
              },
              "relationships": [{"kinds": ["superset"], "target": {"guid": "7a6a0d1e-6b10-3f0e-9e23-5c2b9c3d4e5f", "id": "1004", "toolComponent": {"guid": "b000a760-3e52-3565-a35c-f61369da53b7", "name": "CWE"}}}]
            }
          ]
        }
      },
